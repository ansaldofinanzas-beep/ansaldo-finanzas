# ==============================================================================
# Variables de Entorno para Vercel
# Configurar en: Vercel Dashboard > Project Settings > Environment Variables
# ==============================================================================

# URL de tu proyecto en Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública de Supabase (Project Settings > API > anon / public)
SUPABASE_ANON_KEY=tu-clave-anon-aqui

# (Opcional pero recomendado para Serverless) Clave de servicio de Supabase
# Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-aqui
